# ============================================
# .gitignore: Files to exclude from version control
# ============================================

# Build artifacts
myapp
test
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test coverage output (generated by 'go test -coverprofile')
coverage.out

# Environment files (may contain secrets)
.env
.env.local
.env.*.local

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*.swn
*~

# OS files
.DS_Store
Thumbs.db

# Go module cache (don't commit, each machine downloads its own)
go.sum          # ← NOTE: go.sum SHOULD be committed (it locks dependency versions)
                 #   Only ignore it in projects where you don't control dependencies

# Build binaries (generated during CI/CD — use Docker for portable images)
bin/
dist/

# Logs
*.log
logs/
